# ===================================================================
# CROUS Discord Room Availability Monitor - Environment Configuration
# ===================================================================

# Monitored CROUS Search URL (Copy directly from your browser search)
# Example: https://trouverunlogement.lescrous.fr/tools/42/search?bounds=4.9452443_45.8679317_6.2866978_45.2443315
CROUS_SEARCH_URL=https://trouverunlogement.lescrous.fr/tools/42/search

# Discord Incoming Webhook URL (Create in your Discord Channel Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Optional: Discord User ID to ping/mention on new rooms (e.g. 123456789012345678)
DISCORD_USER_ID=

# Polling interval in seconds (default: 30)
POLL_INTERVAL_SECONDS=30

# Request timeout in seconds (default: 30)
REQUEST_TIMEOUT_SECONDS=30

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Notify on first startup baseline (default: false to avoid spamming existing rooms)
NOTIFY_ON_STARTUP=false

# Optional: Authentication credentials (only if your specific search requires login)
CROUS_EMAIL=
CROUS_PASSWORD=

# SQLite Database Path (default: data/crous_monitor.db)
DATABASE_PATH=data/crous_monitor.db
